livered' AND created_at >= :startOfMonth THEN 1 END)::numeric / \n                    COUNT(CASE WHEN created_at >= :startOfMonth THEN 1 END)::numeric) * 100, 1\n                  )\n                  ELSE 98.4 \n                END,\n                'provider', 'Africa's Talking'\n              ) as sms_gateway\n          FROM sms_logs\n          WHERE created_at >= :startOfMonth\n        )\n        SELECT \n          (SELECT row_to_json(company_stats) FROM company_stats) as companies,\n          (SELECT row_to_json(parcel_stats) FROM parcel_stats) as parcels,\n          (SELECT row_to_json(wallet_stats) FROM wallet_stats) as wallets,\n          (SELECT row_to_json(sms_stats) FROM sms_stats) as sms,\n          (SELECT trends FROM monthly_trends) as monthly_trends,\n          (SELECT top_companies FROM top_companies) as top_companies,\n          (SELECT sms_gateway FROM system_health) as system_health;","service":"courier-api","timestamp":"2026-03-15 11:09:07"}
