 created_at >= :today THEN 1 END) as sms_pending_today,\n            COALESCE(SUM(CASE WHEN created_at >= :today THEN cost ELSE 0 END), 0) as sms_cost_today,\n            COUNT(CASE WHEN created_at >= :startOfMonth THEN 1 END) as sms_this_month,\n            COUNT(CASE WHEN status = 'failed' AND created_at >= :yesterday THEN 1 END) as sms_failed_24h\n          FROM sms_logs\n        ),\n        monthly_trends AS (\n          SELECT \n            json_agg(json_build_object(\n              'month', month,\n              'parcels', parcels,\n              'revenue', revenue\n            ) ORDER BY month ASC) as trends\n          FROM (\n            SELECT \n              DATE_TRUNC('month', created_at) as month,\n              COUNT(*) as parcels,\n              COALESCE(SUM(amount), 0) as revenue\n            FROM parcels\n            WHERE created_at >= (CURRENT_DATE - INTERVAL '11 months')\n            GROUP BY DATE_TRUNC('month', created_at)\n            LIMIT 12\n          ) t\n        ),\n        top_companies AS (\n          SELECT \n            json_agg(json_build_object(\n              'id', c.id,\n              'name', c.name,\n              'parcels', COALESCE(p.parcel_count, 0),\n              'status', c.status\n            )) as top_companies\n          FROM companies c\n          LEFT JOIN (\n            SELECT \n              company_id,\n              COUNT(*) as parcel_count\n            FROM parcels\n            WHERE created_at >= :startOfMonth\n            GROUP BY company_id\n          ) p ON p.company_id = c.id\n          WHERE c.status = 'active'\n          ORDER BY p.parcel_count DESC NULLS LAST\n          LIMIT 5\n        ),\n        system_health AS (\n          SELECT \n              json_build_object(\n                'status', 'online',\n                'delivery_rate', CASE \n                  WHEN COUNT(CASE WHEN created_at >= :startOfMonth THEN 1 END) > 0 \n                  THEN ROUND(\n                    (COUNT(CASE WHEN status = 'de