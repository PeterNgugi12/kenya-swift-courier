{"level":"warn","message":"🐢 SLOW QUERY (1069ms): Executed (default): WITH monthly_data AS (\n          SELECT \n            DATE_TRUNC('month', created_at) as month,\n            COUNT(*) as parcels,\n            COALESCE(SUM(amount), 0) as revenue,\n            COUNT(DISTINCT company_id) as active_companies\n          FROM parcels\n          WHERE created_at >= (CURRENT_DATE - INTERVAL '11 months')\n          GROUP BY DATE_TRUNC('month', created_at)\n        ),\n        previous_year AS (\n          SELECT \n            DATE_TRUNC('month', created_at - INTERVAL '1 year') as month,\n            COUNT(*) as parcels_prev,\n            COALESCE(SUM(amount), 0) as revenue_prev\n          FROM parcels\n          WHERE created_at >= (CURRENT_DATE - INTERVAL '23 months')\n            AND created_at < (CURRENT_DATE - INTERVAL '11 months')\n          GROUP BY DATE_TRUNC('month', created_at - INTERVAL '1 year')\n        )\n        SELECT \n          json_agg(json_build_object(\n            'month', md.month,\n            'parcels', md.parcels,\n            'revenue', md.revenue,\n            'active_companies', md.active_companies,\n            'growth', json_build_object(\n              'parcels', CASE \n                WHEN py.parcels_prev > 0 \n                THEN ROUND(((md.parcels - py.parcels_prev)::numeric / py.parcels_prev * 100), 1)\n                ELSE 0 \n              END,\n              'revenue', CASE \n                WHEN py.revenue_prev > 0 \n                THEN ROUND(((md.revenue - py.revenue_prev) / py.revenue_prev * 100), 1)\n                ELSE 0 \n              END\n            )\n          ) ORDER BY md.month ASC) as trends\n        FROM monthly_data md\n        LEFT JOIN previous_year py ON py.month = md.month;","service":"courier-api","timestamp":"2026-03-15 11:11:32"}
