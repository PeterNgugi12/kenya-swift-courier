{"level":"error","message":"❌ GET /api/dashboard/stats failed: The following SQL query includes an unterminated string literal:\nWITH \n        company_stats AS (\n          SELECT \n            COUNT(*) as total_companies,\n            COUNT(CASE WHEN status = 'active' THEN 1 END) as active_companies,\n            COUNT(CASE WHEN status = 'suspended' THEN 1 END) as suspended_companies\n          FROM companies\n        ),\n        parcel_stats AS (\n          SELECT \n            COUNT(*) as total_parcels,\n            COALESCE(SUM(amount), 0) as total_revenue,\n            COUNT(CASE WHEN created_at >= :startOfMonth THEN 1 END) as parcels_this_month,\n            COALESCE(SUM(CASE WHEN created_at >= :startOfMonth THEN amount ELSE 0 END), 0) as revenue_this_month,\n            COUNT(CASE WHEN created_at >= :today THEN 1 END) as parcels_today,\n            COALESCE(SUM(CASE WHEN created_at >= :today THEN amount ELSE 0 END), 0) as revenue_today,\n            COUNT(CASE WHEN created_at BETWEEN :yesterday AND :today THEN 1 END) as parcels_yesterday,\n            COALESCE(SUM(CASE WHEN created_at BETWEEN :yesterday AND :today THEN amount ELSE 0 END), 0) as revenue_yesterday\n          FROM parcels\n        ),\n        wallet_stats AS (\n          SELECT \n            COALESCE(SUM(balance), 0) as total_balance,\n            COALESCE(SUM(total_deductions), 0) as platform_revenue,\n            COUNT(CASE WHEN balance < 500 AND status = 'active' THEN 1 END) as low_balance_wallets,\n            AVG(balance) as average_balance\n          FROM wallets\n          WHERE status = 'active'\n        ),\n        sms_stats AS (\n          SELECT \n            COUNT(CASE WHEN created_at >= :today THEN 1 END) as sms_today,\n            COUNT(CASE WHEN status = 'delivered' AND created_at >= :today THEN 1 END) as sms_delivered_today,\n            COUNT(CASE WHEN status = 'failed' AND created_at >= :today THEN 1 END) as sms_failed_today,\n            COUNT(CASE WHEN status = 'pending' AND created_at >= :today THEN 1 END) as sms_pending_today,\n            COALESCE(SUM(CASE WHEN created_at >= :today THEN cost ELSE 0 END), 0) as sms_cost_today,\n            COUNT(CASE WHEN created_at >= :startOfMonth THEN 1 END) as sms_this_month,\n            COUNT(CASE WHEN status = 'failed' AND created_at >= :yesterday THEN 1 END) as sms_failed_24h\n          FROM sms_logs\n        ),\n        monthly_trends AS (\n          SELECT \n            json_agg(json_build_object(\n              'month', month,\n              'parcels', parcels,\n              'revenue', revenue\n            ) ORDER BY month ASC) as trends\n          FROM (\n            SELECT \n              DATE_TRUNC('month', created_at) as month,\n              COUNT(*) as parcels,\n              COALESCE(SUM(amount), 0) as revenue\n            FROM parcels\n            WHERE created_at >= (CURRENT_DATE - INTERVAL '11 months')\n            GROUP BY DATE_TRUNC('month', created_at)\n            LIMIT 12\n          ) t\n        ),\n        top_companies AS (\n          SELECT \n            json_agg(json_build_object(\n              'id', c.id,\n              'name', c.name,\n              'parcels', COALESCE(p.parcel_count, 0),\n              'status', c.status\n            )) as top_companies\n          FROM companies c\n          LEFT JOIN (\n            SELECT \n              company_id,\n              COUNT(*) as parcel_count\n            FROM parcels\n            WHERE created_at >= :startOfMonth\n            GROUP BY company_id\n          ) p ON p.company_id = c.id\n          WHERE c.status = 'active'\n          ORDER BY p.parcel_count DESC NULLS LAST\n          LIMIT 5\n        ),\n        system_health AS (\n          SELECT \n              json_build_object(\n                'status', 'online',\n                'delivery_rate', CASE \n                  WHEN COUNT(CASE WHEN created_at >= :startOfMonth THEN 1 END) > 0 \n                  THEN ROUND(\n                    (COUNT(CASE WHEN status = 'delivered' AND created_at >= :startOfMonth THEN 1 END)::numeric / \n                    COUNT(CASE WHEN created_at >= :startOfMonth THEN 1 END)::numeric) * 100, 1\n                  )\n                  ELSE 98.4 \n                END,\n                'provider', 'Africa's Talking'\n              ) as sms_gateway\n          FROM sms_logs\n          WHERE created_at >= :startOfMonth\n        )\n        SELECT \n          (SELECT row_to_json(company_stats) FROM company_stats) as companies,\n          (SELECT row_to_json(parcel_stats) FROM parcel_stats) as parcels,\n          (SELECT row_to_json(wallet_stats) FROM wallet_stats) as wallets,\n          (SELECT row_to_json(sms_stats) FROM sms_stats) as sms,\n          (SELECT trends FROM monthly_trends) as monthly_trends,\n          (SELECT top_companies FROM top_companies) as top_companies,\n          (SELECT sms_gateway FROM system_health) as system_health;","service":"courier-api","timestamp":"2026-03-15 11:09:37"}
