() \n            AND v.status = 'active'\n          LIMIT 5\n        ),\n        recent_failures AS (\n          SELECT \n            json_agg(json_build_object(\n              'id', s.id,\n              'phone', s.phone_number,\n              'status', s.status,\n              'created_at', s.created_at\n            ) ORDER BY s.created_at DESC) as recent_failures  -- FIXED: Moved ORDER BY inside json_agg\n          FROM sms_logs s\n          WHERE s.status = 'failed'\n          LIMIT 5\n        )\n        SELECT \n          (SELECT low_balance_wallets FROM low_balance) as low_balance_wallets,\n          (SELECT suspended_companies FROM suspended) as suspended_companies,\n          (SELECT failed_sms_24h FROM failed_sms) as failed_sms_24h,\n          (SELECT expiring_licenses FROM expiring_licenses) as expiring_licenses,\n          (SELECT overdue_maintenance FROM overdue_maintenance) as overdue_maintenance,\n          (SELECT recent_failures FROM recent_failures) as recent_failures;","service":"courier-api","timestamp":"2026-03-15 11:11:33"}
