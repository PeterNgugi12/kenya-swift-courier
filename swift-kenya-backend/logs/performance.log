{"level":"warn","message":"🐢 SLOW QUERY (1561ms): Executed (default): WITH \n        low_balance AS (\n          SELECT \n            json_agg(json_build_object(\n              'company_id', w.company_id,\n              'company_name', c.name,\n              'balance', w.balance,\n              'status', w.status\n            )) as low_balance_wallets\n          FROM wallets w\n          JOIN companies c ON c.id = w.company_id\n          WHERE w.balance < 500 AND w.status = 'active'\n          LIMIT 5\n        ),\n        suspended AS (\n          SELECT \n            json_agg(json_build_object(\n              'id', c.id,\n              'name', c.name,\n              'code', c.code,\n              'suspended_at', c.updated_at\n            )) as suspended_companies\n          FROM companies c\n          WHERE c.status = 'suspended'\n          LIMIT 5\n        ),\n        failed_sms AS (\n          SELECT COUNT(*) as failed_sms_24h\n          FROM sms_logs\n          WHERE status = 'failed'\n            AND created_at >= NOW() - INTERVAL '24 hours'\n        ),\n        expiring_licenses AS (\n          SELECT \n            json_agg(json_build_object(\n              'driver_id', d.id,\n              'driver_name', d.name,\n              'license_number', d.license_number,\n              'expiry_date', d.license_expiry,\n              'days_left', EXTRACT(DAY FROM (d.license_expiry - NOW()))\n            )) as expiring_licenses\n          FROM drivers d\n          WHERE d.license_expiry BETWEEN NOW() AND NOW() + INTERVAL '30 days'\n          LIMIT 5\n        ),\n        overdue_maintenance AS (\n          SELECT \n            json_agg(json_build_object(\n              'vehicle_id', v.id,\n              'plate_number', v.plate_number,\n              'last_maintenance', v.last_maintenance,\n              'days_overdue', EXTRACT(DAY FROM (NOW() - v.next_maintenance))\n            )) as overdue_maintenance\n          FROM vehicles v\n          WHERE v.next_maintenance < NOW() \n            AND v.status = 'active'\n          LIMIT 5\n        ),\n        recent_failures AS (\n          SELECT \n            json_agg(json_build_object(\n              'id', s.id,\n              'phone', s.phone_number,\n              'status', s.status,\n              'created_at', s.created_at\n            ) ORDER BY s.created_at DESC) as recent_failures  -- FIXED: Moved ORDER BY inside json_agg\n          FROM sms_logs s\n          WHERE s.status = 'failed'\n          LIMIT 5\n        )\n        SELECT \n          (SELECT low_balance_wallets FROM low_balance) as low_balance_wallets,\n          (SELECT suspended_companies FROM suspended) as suspended_companies,\n          (SELECT failed_sms_24h FROM failed_sms) as failed_sms_24h,\n          (SELECT expiring_licenses FROM expiring_licenses) as expiring_licenses,\n          (SELECT overdue_maintenance FROM overdue_maintenance) as overdue_maintenance,\n          (SELECT recent_failures FROM recent_failures) as recent_failures;","service":"courier-api","timestamp":"2026-03-15 11:21:35"}
